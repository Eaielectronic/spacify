{
  "name": "electron_player",
  "version": "1.1.3",
  "description": "Music player using Pixabay API",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "start": "concurrently \"npm run dev\" \"npm run electron:dev\"",
    "electron:dev": "cross-env NODE_ENV=development wait-on tcp:5175 && npm run electron:build && electron .",
    "release": "npm run build && npm run electron:build && electron-builder --mac --win"
  },
  "build": {
    "appId": "com.electron.player",
    "productName": "Spacify Player",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@anuradev/capacitor-background-mode": "^7.2.1",
    "@capacitor/core": "^8.0.2",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/preferences": "^8.0.0",
    "@capawesome/capacitor-file-picker": "^8.0.1",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^11.0.3",
    "howler": "^2.2.4",
    "lucide-react": "^0.330.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-virtuoso": "^4.18.1",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/cli": "^8.0.2",
    "@types/howler": "^2.2.12",
    "@types/node": "^20.11.17",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.1",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.1",
    "wait-on": "^7.2.0"
  }
}
